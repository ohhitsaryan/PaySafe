# ============================================================
# PaySafe Environment Configuration
# Copy this file to backend/.env (do NOT commit your real .env)
# ============================================================

# --- Server ---
PORT=8000

# --- Gemini API (Google AI Studio) ---
GEMINI_API_KEY=your_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=models/gemini-3.5-flash-lite

# --- PayPal Sandbox Credentials (developer.paypal.com) ---
PAYPAL_CLIENT_ID=your_id_here
PAYPAL_CLIENT_SECRET=your_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Redirect URLs ---
PAYPAL_RETURN_URL=http://localhost:3000/success
PAYPAL_CANCEL_URL=http://localhost:3000/cancel
