# ============================================================
# PaySafe .gitignore
# ============================================================

# Environment files (CRITICAL: Never commit secrets)
.env
.env.*
*.env
**/.env
backend/.env
!.env.example
!*.env.example

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Node Dependencies & Cache
# (Note: extension/dist is intentionally tracked so evaluators can load unpacked in Chrome without running npm build)
node_modules/
**/node_modules/
.npm
.eslintcache

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
